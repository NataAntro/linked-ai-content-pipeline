# Локальные провайдеры не требуют секретов или внешних API.
# Для генерации через OpenAI-compatible Responses API:
LINKED_LLM_PROVIDER=local
LLM_ENDPOINT=https://api.openai.com/v1/responses
LLM_MODEL=gpt-5-mini
LLM_API_KEY=replace_me

# Для внешних эмбеддингов и Qdrant:
LINKED_RETRIEVAL_PROVIDER=local
EMBEDDING_ENDPOINT=https://api.openai.com/v1/embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_API_KEY=replace_me
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=linked_editorial_context
# QDRANT_API_KEY=replace_me
